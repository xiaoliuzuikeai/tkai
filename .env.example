# 可提交的环境变量。
DEEPSEEK_API_KEY=
DASHSCOP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOP_API_KEY=
OPENAI_MODEL_NAME=qwen-turbo
TAVILY_API_KEY=

APP_HOST=0.0.0.0
APP_PORT=9090
# [第三阶段优化-超时] 单位均为秒。
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.7
AI_MAX_CONTEXT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=2000
AI_RECENT_TURNS=8
AI_RETRY_MAX=2
AI_CIRCUIT_FAILURES=5
AI_CIRCUIT_OPEN_SECONDS=30

RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=10
RAG_MAX_CONTEXT_TOKENS=4000
RAG_DISTANCE_THRESHOLD=0.55

MCP_BASE_URL=http://localhost:8081/mcp
MCP_TOOL_TIMEOUT_SECONDS=10
MCP_MAX_TOOL_ROUNDS=3
MCP_MAX_TOOL_OUTPUT_BYTES=32768

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=24
JWT_ISSUER=GoAI
JWT_SUBJECT=access-token

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=GopherAI
MYSQL_CHARSET=utf8mb4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=gopherai.messages
KAFKA_CONSUMER_GROUP=gopherai-message-persist

SMTP_EMAIL=
SMTP_PASSWORD=
VOICE_SERVICE_API_KEY=
VOICE_SERVICE_SECRET_KEY=
